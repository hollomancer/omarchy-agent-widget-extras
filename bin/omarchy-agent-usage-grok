#!/usr/bin/python3
# omarchy:summary=Print the Grok CLI usage record as JSON
# omarchy:args=[--force] [--limits-only]
"""Collect Grok CLI (xai/grok) usage into one display-ready JSON record,
matching the schema Omarchy's omarchy.agents bar widget expects.

Unlike Claude Code and Codex, Grok has no documented rate-limit/plan RPC or
endpoint reachable from the CLI, so this collector only ever reports local
stats: it walks ~/.grok/sessions/<encoded-cwd>/<session-id>/summary.json for
session/turn counts and usage.json - Grok's own persisted token ledger, the
same data `grok usage <session-id>` prints - for tokens, per-model splits and
per-turn timestamps. Sessions predating usage.json fall back to message counts.

--force and --limits-only are accepted for compatibility with Omarchy's
collector-invocation contract but change nothing here: there is no remote
call to skip or force a refresh of.

This script is not part of Omarchy's own package (there is no first-party
Grok collector), so nothing dispatches it automatically. Install it with
install.sh, which also sets up a systemd --user timer that runs it and
writes straight to the usage directory the panel watches.
"""

import argparse
import base64
import json
import os
import shutil
from datetime import datetime, timedelta, timezone
from pathlib import Path

AGENT_ID = "grok"
AGENT_NAME = "Grok"
AUTH_HELP = "Run `grok login` to authenticate."

# costUsdTicks is Grok's integer money unit. xAI documents neither the scale
# nor the tier numbering, so both are handled literally: ticks are read as
# nanodollars because that is the only reading that puts this account's
# recorded spend at a sane per-token price, and the balance it feeds is always
# flagged estimated. `tierLabel` in the config file overrides the raw claim
# when you know the marketing name for your plan.
TICKS_PER_USD = 1_000_000_000

# xAI documents no mapping from the numeric `tier` claim to a plan name, so
# this holds only values confirmed against a real account. Anything absent
# renders as "Tier N" rather than guessing at the ladder, and `tierLabel` in
# the config file overrides both.
TIER_NAMES = {
  5: "SuperGrok Heavy",
}


def config_home():
  return Path(os.environ.get("XDG_CONFIG_HOME") or (Path.home() / ".config"))


def read_config():
  data = read_json(config_home() / "omarchy" / "agents" / "grok.json")
  return data if isinstance(data, dict) else {}


def grok_home():
  return Path(os.environ.get("GROK_HOME") or (Path.home() / ".grok"))


def find_command(name):
  return shutil.which(name)


def number(value):
  try:
    return int(value or 0)
  except Exception:
    return 0


def local_day(value):
  if value is None:
    return datetime.now().strftime("%Y-%m-%d")
  if isinstance(value, (int, float)):
    seconds = value / 1000 if value > 10_000_000_000 else value
    try:
      return datetime.fromtimestamp(seconds).strftime("%Y-%m-%d")
    except Exception:
      return datetime.now().strftime("%Y-%m-%d")
  text = str(value)
  try:
    if text.endswith("Z"):
      dt = datetime.fromisoformat(text[:-1] + "+00:00")
    else:
      dt = datetime.fromisoformat(text)
    if dt.tzinfo is not None:
      dt = dt.astimezone()
    return dt.strftime("%Y-%m-%d")
  except Exception:
    return datetime.now().strftime("%Y-%m-%d")


def model_name(raw):
  value = str(raw or "grok")
  return value if value else "grok"


def read_json(path):
  try:
    return json.loads(path.read_text(encoding="utf-8"))
  except Exception:
    return None


# Grok keeps its own token ledger beside each session in usage.json - the same
# data `grok usage <session-id>` prints. It carries the per-model split and a
# turns[] array stamped with end times, so tokens are read from there and each
# day is credited to the turn that earned it. signals.json, which this used to
# read, records latency and tool telemetry but carries no token counts at all.
GROK_TOKEN_FIELDS = (
  ("input", "inputTokens"),
  ("output", "outputTokens"),
  ("cacheRead", "cachedReadTokens"),
  ("cacheCreation", "cacheCreationTokens"),
)


def usage_tokens(block):
  if not isinstance(block, dict):
    return None
  tokens = {key: number(block.get(field)) for key, field in GROK_TOKEN_FIELDS}
  # Grok counts cached reads inside inputTokens; Claude and Codex report them
  # as a bucket of their own. Subtract so the panel's input/cache hover means
  # the same thing on every tab - the three still sum to totalTokens.
  raw_input = tokens["input"]
  tokens["input"] = max(0, raw_input - tokens["cacheRead"])
  tokens["total"] = number(block.get("totalTokens")) or raw_input + tokens["output"]
  tokens["costUsd"] = number(block.get("costUsdTicks")) / TICKS_PER_USD
  return tokens


def empty_bucket():
  return {
    "inputTokens": 0,
    "outputTokens": 0,
    "cacheReadInputTokens": 0,
    "cacheCreationInputTokens": 0,
  }


def add_tokens(bucket, tokens):
  bucket["inputTokens"] += tokens["input"]
  bucket["outputTokens"] += tokens["output"]
  bucket["cacheReadInputTokens"] += tokens["cacheRead"]
  bucket["cacheCreationInputTokens"] += tokens["cacheCreation"]


def model_blocks(block):
  """Per-model usage where Grok recorded it, else the block's own totals."""
  if not isinstance(block, dict):
    return []
  per_model = block.get("modelUsage")
  if isinstance(per_model, dict) and per_model:
    pairs = []
    for raw_model, model_block in per_model.items():
      tokens = usage_tokens(model_block)
      if tokens:
        pairs.append((model_name(raw_model), tokens))
    if pairs:
      return pairs
  tokens = usage_tokens(block)
  if tokens is None:
    return []
  return [(model_name(block.get("primaryModelId")), tokens)]


def collect_local_stats(spend_since=None):
  now = datetime.now()
  today = now.strftime("%Y-%m-%d")
  recent_dates = [(now - timedelta(days=offset)).strftime("%Y-%m-%d") for offset in range(6, -1, -1)]
  recent = {day: {"date": day, "messageCount": 0} for day in recent_dates}

  today_prompts = 0
  today_sessions = set()
  today_total_tokens = 0
  today_tokens_by_model = {}
  total_prompts = 0
  total_sessions = set()
  active_days = set()
  model_usage = {}
  spend_usd = 0.0

  def record_activity(day, model, tokens, session_key):
    nonlocal today_total_tokens, spend_usd
    add_tokens(model_usage.setdefault(model, empty_bucket()), tokens)
    active_days.add(day)
    # Spend is clipped to the funding window so a top-up's funded figure and
    # the spend charged against it always cover the same period.
    if spend_since is None or day >= spend_since:
      spend_usd += tokens["costUsd"]
    if day in recent:
      recent[day]["messageCount"] += tokens["total"]
    if day == today:
      today_total_tokens += tokens["total"]
      today_tokens_by_model[model] = today_tokens_by_model.get(model, 0) + tokens["total"]
      today_sessions.add(session_key)

  sessions_root = grok_home() / "sessions"
  if sessions_root.is_dir():
    for summary_path in sessions_root.glob("*/*/summary.json"):
      session_dir = summary_path.parent
      summary = read_json(summary_path)
      if not isinstance(summary, dict):
        continue

      session_key = str(session_dir)
      info = summary.get("info") if isinstance(summary.get("info"), dict) else {}
      when = summary.get("updated_at") or summary.get("created_at") or info.get("updated_at")
      session_day = local_day(when)

      usage = read_json(session_dir / "usage.json")
      session_block = usage.get("session") if isinstance(usage, dict) else None
      turns = usage.get("turns") if isinstance(usage, dict) else None
      turn_list = [turn for turn in (turns or []) if isinstance(turn, dict)]

      total_sessions.add(session_key)
      active_days.add(session_day)

      if isinstance(session_block, dict) and turn_list:
        # A turn is one prompt-and-response exchange, which is what the panel's
        # hover count means. num_chat_messages counts system and tool messages
        # too and inflates the same session several times over.
        for turn in turn_list:
          turn_day = local_day(turn.get("endedAt") or when)
          for model, tokens in model_blocks(turn):
            record_activity(turn_day, model, tokens, session_key)
          total_prompts += 1
          if turn_day == today:
            today_prompts += 1
            today_sessions.add(session_key)
      elif isinstance(session_block, dict):
        prompts = number(session_block.get("turnCount")) or 1
        for model, tokens in model_blocks(session_block):
          record_activity(session_day, model, tokens, session_key)
        total_prompts += prompts
        if session_day == today:
          today_prompts += prompts
          today_sessions.add(session_key)
      else:
        # Sessions written before Grok kept a usage.json have no token record;
        # count their messages so they still register as activity instead of
        # disappearing from the week.
        messages = number(summary.get("num_chat_messages") or summary.get("num_messages"))
        model = model_name(summary.get("current_model_id"))
        model_usage.setdefault(model, empty_bucket())
        prompts = messages or 1
        if session_day in recent:
          recent[session_day]["messageCount"] += messages
        total_prompts += prompts
        if session_day == today:
          today_prompts += prompts
          today_total_tokens += messages
          today_tokens_by_model[model] = today_tokens_by_model.get(model, 0) + messages
          today_sessions.add(session_key)

  return {
    "todayPrompts": today_prompts,
    "todaySessions": len(today_sessions),
    "todayTotalTokens": today_total_tokens,
    "todayTokensByModel": today_tokens_by_model,
    "recentDays": [recent[day] for day in recent_dates],
    "totalPrompts": total_prompts,
    "totalSessions": len(total_sessions),
    "activeDays": len(active_days),
    "activeDates": sorted(active_days),
    "modelUsage": model_usage,
    "_spendUsd": spend_usd,
  }


def token_claims():
  """Claims from the stored Grok access token.

  The token is the user's own and is only decoded here - never verified, and
  never sent anywhere - to read the `tier` claim the hero line needs.
  """
  auth = read_json(grok_home() / "auth.json")
  if not isinstance(auth, dict):
    return {}
  for entry in auth.values():
    if not isinstance(entry, dict):
      continue
    token = entry.get("key")
    if not isinstance(token, str):
      continue
    parts = token.split(".")
    if len(parts) != 3:
      continue
    try:
      padded = parts[1] + "=" * (-len(parts[1]) % 4)
      claims = json.loads(base64.urlsafe_b64decode(padded))
    except Exception:
      continue
    if isinstance(claims, dict):
      return claims
  return {}


def tier_label(config):
  override = config.get("tierLabel")
  if isinstance(override, str) and override.strip():
    return override.strip()
  tier = token_claims().get("tier")
  if tier is None or isinstance(tier, bool):
    return ""
  if isinstance(tier, (int, float)):
    level = int(tier)
    return TIER_NAMES.get(level) or "Tier {}".format(level)
  text = str(tier).strip()
  return text


def balance_block(config, spend_usd, spend_since):
  """What Grok cost, plus a budget meter when you declare one.

  Grok is a subscription with no credit ledger to read, so the money section
  shows recorded spend on its own. A `fundedAmount` in the config adds the
  funded figure and turns it into a draining meter, the way the prepaid
  collectors work.
  """
  try:
    funded = float(config.get("fundedAmount") or 0)
  except (TypeError, ValueError):
    funded = 0.0
  funded = max(0.0, funded)
  spent = round(max(0.0, spend_usd), 6)
  if funded <= 0 and spent <= 0:
    return None

  label = config.get("balanceLabel")
  if not (isinstance(label, str) and label.strip()):
    if funded > 0:
      label = "Budget remaining"
    elif spend_since:
      label = "Spent since {}".format(spend_since)
    else:
      label = "Spent, all time"

  return {
    "remaining": round(max(0.0, funded - spent), 6) if funded > 0 else 0.0,
    "funded": funded,
    "spent": spent,
    "currency": str(config.get("currency") or "USD"),
    "estimated": True,
    "label": label.strip(),
  }


def auth_status():
  if not find_command("grok"):
    return {"usageStatusText": "Grok unavailable", "authHelpText": "grok not found in PATH"}

  signed_in = (grok_home() / "auth.json").exists() or bool(os.environ.get("XAI_API_KEY"))
  if not signed_in:
    return {"usageStatusText": "Grok usage unavailable", "authHelpText": AUTH_HELP}

  # No known endpoint for plan/rate-limit data, so there is nothing to
  # report here beyond local stats - leave both blank rather than invent a
  # status.
  return {"usageStatusText": "", "authHelpText": ""}


def main():
  parser = argparse.ArgumentParser()
  parser.add_argument("--force", action="store_true")
  parser.add_argument("--limits-only", action="store_true")
  parser.parse_args()

  record = {
    "schemaVersion": 1,
    "id": AGENT_ID,
    "name": AGENT_NAME,
    "updatedAt": datetime.now(timezone.utc).isoformat(),
    "ready": True,
    "hasLocalStats": True,
    "limits": [],
  }
  config = read_config()
  record["tierLabel"] = tier_label(config)

  funded_at = config.get("fundedAt")
  spend_since = local_day(funded_at) if funded_at else None
  stats = collect_local_stats(spend_since)
  spend_usd = stats.pop("_spendUsd", 0.0)
  record.update(stats)

  balance = balance_block(config, spend_usd, spend_since)
  if balance:
    record["balance"] = balance

  record.update(auth_status())
  print(json.dumps(record, separators=(",", ":")))


if __name__ == "__main__":
  main()
