[Unit]
Description=Regenerate the OpenRouter usage record for the Omarchy agents widget

[Service]
Type=oneshot
ExecStart=/bin/sh -c '\
  dir="${XDG_STATE_HOME:-$HOME/.local/state}/omarchy/agents/usage"; \
  mkdir -p "$dir"; \
  tmp=$(mktemp "$dir/.openrouter.XXXXXX"); \
  if "$HOME/.local/bin/omarchy-agent-usage-openrouter" > "$tmp"; then \
    mv "$tmp" "$dir/openrouter.json"; \
  else \
    rm -f "$tmp"; \
  fi'
